{
  "name": "terminal-preservation",
  "rules": [
    {
      "when": {
        "id": [
          "normal"
        ],
        "geometry": [
          "none"
        ]
      },
      "outcome": "native",
      "next": "",
      "cells": 2
    },
    {
      "when": {
        "id": [
          "zero",
          "sentinel"
        ],
        "geometry": [
          "none"
        ],
        "count": [
          "one"
        ]
      },
      "outcome": "NC",
      "next": "",
      "cells": 2
    },
    {
      "when": {
        "id": [
          "sentinel"
        ],
        "geometry": [
          "none"
        ],
        "count": [
          "two"
        ]
      },
      "outcome": "overlap",
      "next": "",
      "cells": 1
    },
    {
      "when": {
        "id": [
          "zero"
        ],
        "geometry": [
          "none"
        ]
      },
      "outcome": "NC",
      "next": "",
      "cells": 1
    }
  ],
  "default": {
    "outcome": "wire",
    "next": ""
  }
}
