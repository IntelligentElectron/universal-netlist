{
  "name": "reference-designators",
  "rules": [
    {
      "when": {
        "stem": [
          "letters",
          "underscore"
        ],
        "leading": [
          "none",
          "one hyphen"
        ],
        "suffix": [
          "none",
          "duplicate index"
        ]
      },
      "outcome": "preserved",
      "next": "",
      "cells": 8
    }
  ],
  "default": {
    "outcome": "rejected",
    "next": ""
  }
}
