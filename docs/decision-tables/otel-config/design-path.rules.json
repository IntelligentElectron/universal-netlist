{
  "name": "otel-design-path",
  "rules": [
    {
      "when": {
        "root": [
          "set",
          "built_in",
          "built_in_home",
          "set_over_built_in"
        ],
        "extension": [
          "design"
        ],
        "location": [
          "inside_root"
        ]
      },
      "outcome": "relative path",
      "next": "",
      "cells": 4
    }
  ],
  "default": {
    "outcome": "omitted",
    "next": ""
  }
}
